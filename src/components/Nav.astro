---
const { current } = Astro.props;
const items = [
  { href: '/framework/', label: 'Framework', key: 'framework' },
  { href: '/research/', label: 'Research', key: 'research' },
  { href: '/people/', label: 'People', key: 'people' },
  { href: '/publications/', label: 'Publications', key: 'publications' },
  { href: '/tools/', label: 'Tools', key: 'tools' },
  { href: '/students/', label: 'New Students', key: 'students' },
  { href: '/news/', label: 'News', key: 'news' },
  { href: '/join/', label: 'Join', key: 'join' },
];
---
<header class="topbar" aria-label="Site">
  <div class="container-page flex items-center justify-between py-4">
    <a href="/" class="brand inline-flex items-baseline gap-2.5">
      <span class="tick" aria-hidden="true"></span>
      <span class="name">AURA&nbsp;Lab</span>
    </a>
    <div class="flex items-center gap-4 lg:gap-6">
      <nav aria-label="Primary" class="hidden md:block">
        <ul class="flex gap-5 lg:gap-6">
          {items.map((it) => (
            <li>
              <a href={it.href}
                 class={`navlink link-underline ${current === it.key ? 'on' : ''}`}
                 aria-current={current === it.key ? 'page' : undefined}>
                {it.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.7"/>
          <path d="M12 3.5 A8.5 8.5 0 0 0 12 20.5 Z" fill="currentColor"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    function wire() {
      var btn = document.getElementById('theme-toggle');
      if (!btn || btn.dataset.wired) return;
      btn.dataset.wired = '1';
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme') || 'dark';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        var mc = document.querySelector('meta[name="theme-color"]');
        if (mc) mc.setAttribute('content', next === 'light' ? '#f6f3ec' : '#101113');
      });
    }
    wire();
    document.addEventListener('astro:page-load', wire);
  })();
</script>

<style>
  .topbar {
    position: sticky; top: 0; z-index: 20;
    backdrop-filter: blur(8px);
    background: color-mix(in srgb, var(--paper) 84%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .brand .name {
    font-family: theme('fontFamily.display');
    font-weight: 800;
    letter-spacing: -0.01em;
    font-size: 1.15rem;
    color: var(--ink);
  }
  /* the one place the EXACT SIUE red appears — the institutional mark */
  .tick {
    width: 9px; height: 9px;
    background: var(--siue);
    transform: rotate(45deg);
    border-radius: 1px;
    align-self: center;
  }
  .affil {
    font-family: theme('fontFamily.sans');
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  @media (max-width: 1440px) { .affil { display: none; } }
  .navlink {
    white-space: nowrap;
    font-family: theme('fontFamily.sans');
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 200ms var(--ease-out);
  }
  .navlink:hover { color: var(--ink); }
  .navlink.on { color: var(--brick); }
  .theme-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 999px;
    color: var(--ink-soft); background: transparent;
    border: 1px solid var(--line); cursor: pointer;
    transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .theme-toggle:hover { color: var(--ink); border-color: var(--brick); }
  .theme-toggle svg { display: block; }
</style>
