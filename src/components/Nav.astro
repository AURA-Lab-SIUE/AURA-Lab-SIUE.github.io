---
/**
 * Site header, modelled on siue.edu's own pages (2026-09-15): the University
 * signature line sits at the left of the navigation row and the unit name is
 * a separate header block BELOW the row, never beside the mark.
 *
 * Why this shape: the signature line is the site's primary identifier
 * (Philip Sherrill, UMC, 2026-09-11) and must appear on official University
 * websites, upper left where possible (Visual Identity Requirements p.8).
 * Departments may not place their names above, below or alongside it except
 * through a UMC lockup (p.7); the same page allows the unit name "as a main
 * header". So "AURA Lab" lives in its own band under the nav row, separated
 * from the mark by the row's padding and border.
 *
 * Clearspace (p.19): no element within one mark-height of the mark. The mark
 * renders at 36px and the row pads 36px above and below it; the nav links sit
 * far to the right. Artwork is the official file from the UMC wordmarks
 * download page, unmodified. Never redraw, recolour or crop it.
 */
const { current } = Astro.props;
const items = [
  { href: '/framework/', label: 'Framework', key: 'framework' },
  { href: '/research/', label: 'Research', key: 'research' },
  { href: '/people/', label: 'People', key: 'people' },
  { href: '/publications/', label: 'Publications', key: 'publications' },
  { href: '/tools/', label: 'Tools', key: 'tools' },
  { href: '/students/', label: 'New Students', key: 'students' },
  { href: '/news/', label: 'News', key: 'news' },
  { href: '/join/', label: 'Join', key: 'join' },
];
---
<header class="topbar" aria-label="Site">
  <div class="container-page flex items-center justify-between">
    <a class="siue-link" href="https://www.siue.edu" aria-label="Southern Illinois University Edwardsville home">
      <img
        class="siue-mark siue-mark--light"
        src="/img/siue-signature-line-black.png"
        alt="Southern Illinois University Edwardsville"
        width="1155" height="251" />
      <img
        class="siue-mark siue-mark--dark"
        src="/img/siue-signature-line-white.png"
        alt="Southern Illinois University Edwardsville"
        width="720" height="156" />
    </a>
    <div class="flex items-center gap-4 lg:gap-6">
      <nav aria-label="Primary" class="hidden md:block">
        <ul class="flex gap-5 lg:gap-6">
          {items.map((it) => (
            <li>
              <a href={it.href}
                 class={`navlink link-underline ${current === it.key ? 'on' : ''}`}
                 aria-current={current === it.key ? 'page' : undefined}>
                {it.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.7"/>
          <path d="M12 3.5 A8.5 8.5 0 0 0 12 20.5 Z" fill="currentColor"/>
        </svg>
      </button>
      <button type="button" id="nav-toggle" class="nav-toggle md:hidden"
              aria-label="Menu" aria-expanded="false" aria-controls="nav-panel">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path class="nav-icon-bars" d="M4 7h16M4 12h16M4 17h16" fill="none"
                stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          <path class="nav-icon-x" d="M6 6l12 12M18 6L6 18" fill="none"
                stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
  <nav id="nav-panel" class="nav-panel md:hidden" aria-label="Primary" hidden>
    <ul class="container-page">
      {items.map((it) => (
        <li>
          <a href={it.href}
             class={`navlink navlink--stacked ${current === it.key ? 'on' : ''}`}
             aria-current={current === it.key ? 'page' : undefined}>
            {it.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<div class="sitename" aria-label="AURA Lab">
  <div class="container-page">
    <a href="/" class="brand">
      <span class="name">AURA&nbsp;Lab</span>
      <span class="expand" aria-hidden="true">Avatars · Users · Relationships · Affect</span>
    </a>
  </div>
</div>

<script is:inline>
  (function () {
    function wire() {
      var btn = document.getElementById('theme-toggle');
      if (!btn || btn.dataset.wired) return;
      btn.dataset.wired = '1';
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme') || 'dark';
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        var mc = document.querySelector('meta[name="theme-color"]');
        if (mc) mc.setAttribute('content', next === 'light' ? '#f6f3ec' : '#101113');
      });
    }
    function wireNav() {
      var btn = document.getElementById('nav-toggle');
      var panel = document.getElementById('nav-panel');
      if (!btn || !panel || btn.dataset.wired) return;
      btn.dataset.wired = '1';
      function setOpen(open) {
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) { panel.removeAttribute('hidden'); } else { panel.setAttribute('hidden', ''); }
      }
      btn.addEventListener('click', function () {
        setOpen(btn.getAttribute('aria-expanded') !== 'true');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          setOpen(false); btn.focus();
        }
      });
      panel.addEventListener('click', function (e) {
        if (e.target.closest('a')) setOpen(false);
      });
      var mq = window.matchMedia('(min-width: 768px)');
      var onChange = function () { if (mq.matches) setOpen(false); };
      if (mq.addEventListener) { mq.addEventListener('change', onChange); }
      else if (mq.addListener) { mq.addListener(onChange); }
    }
    wire();
    wireNav();
    document.addEventListener('astro:page-load', function () { wire(); wireNav(); });
  })();
</script>

<style>
  .topbar {
    position: sticky; top: 0; z-index: 20;
    backdrop-filter: blur(8px);
    background: color-mix(in srgb, var(--paper) 84%, transparent);
    border-bottom: 1px solid var(--line);
  }
  /* 36px of padding above and below a 36px mark = the p.19 clearspace.
     The guide sets no numeric minimum for the signature line, only that
     marks stay legible (p.20); 30px read too small on a desktop display. */
  .topbar > .container-page { padding-block: 36px; }
  .siue-link { display: inline-block; line-height: 0; }
  .siue-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .siue-mark { height: 36px; width: auto; display: block; }
  .siue-mark--dark { display: none; }
  :root[data-theme="dark"] .siue-mark--light { display: none; }
  :root[data-theme="dark"] .siue-mark--dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .siue-mark--light { display: none; }
    :root:not([data-theme="light"]) .siue-mark--dark { display: block; }
  }
  @media (max-width: 640px) {
    .topbar > .container-page { padding-block: 24px; }
    .siue-mark { height: 24px; }
  }

  /* The unit name as its own header block under the row, the way siue.edu
     places "Academics" under its navigation. Plain text, deliberately NOT a
     stylised wordmark: units may not create their own marks (p.7). */
  .sitename {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .sitename > .container-page { padding-block: 14px; }
  .brand {
    display: inline-flex; align-items: baseline; gap: 14px;
    text-decoration: none;
  }
  .brand .name {
    font-family: theme('fontFamily.display');
    font-weight: 600;
    letter-spacing: 0;
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--ink);
  }
  .brand .expand {
    font-family: theme('fontFamily.sans');
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  @media (max-width: 640px) {
    .brand .name { font-size: 1.3rem; }
    .brand .expand { display: none; }
  }

  .navlink {
    white-space: nowrap;
    font-family: theme('fontFamily.sans');
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 200ms var(--ease-out);
  }
  .navlink:hover { color: var(--ink); }
  .navlink.on { color: var(--accent-text); }
  .theme-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 999px;
    color: var(--ink-soft); background: transparent;
    border: 1px solid var(--line); cursor: pointer;
    transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .theme-toggle:hover { color: var(--ink); border-color: var(--brick); }
  .theme-toggle svg { display: block; }

  /* Mobile menu. Below md the primary nav is display:none (hidden md:block),
     so without this control there is NO way to navigate the site on a phone -
     which is exactly what shipped until 2026-09-27. The button and panel are
     md:hidden, so the desktop header is untouched. */
  .nav-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 999px;
    color: var(--ink-soft); background: transparent;
    border: 1px solid var(--line); cursor: pointer;
    transition: color 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  .nav-toggle:hover { color: var(--ink); border-color: var(--brick); }
  .nav-toggle svg { display: block; }
  .nav-toggle .nav-icon-x { display: none; }
  .nav-toggle[aria-expanded="true"] .nav-icon-bars { display: none; }
  .nav-toggle[aria-expanded="true"] .nav-icon-x { display: block; }

  .nav-panel { border-top: 1px solid var(--line); }
  .nav-panel[hidden] { display: none; }
  .nav-panel ul { display: flex; flex-direction: column; padding-block: 8px; }
  .navlink--stacked {
    display: flex; align-items: center;
    min-height: 44px;            /* WCAG 2.5.5 target size */
    font-size: 0.82rem;
    letter-spacing: 0.08em;
  }

  /* The theme toggle is 32px, under the 44px target minimum. Widen the hit
     area on touch layouts without changing how it looks on the desktop row. */
  @media (max-width: 767px) {
    .theme-toggle { width: 44px; height: 44px; }
  }
</style>
