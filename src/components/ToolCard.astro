---
interface SeeAlso { label: string; href: string; }
interface Props {
  name: string;
  blurb: string;
  href: string;
  language: string;
  repo?: string;
  seeAlso?: SeeAlso;
}
const { name, blurb, href, language, repo, seeAlso } = Astro.props;
const external = href.startsWith('http');
const isLive = external || href.startsWith('/');
// A live/hosted app gets an "Open" affordance; a bare repo gets "Repository".
const primaryLabel = repo || !external ? 'Open ↗' : 'Repository ↗';
---
<article class="card p-6 flex flex-col">
  <header class="flex items-baseline justify-between gap-4">
    <h3 class="font-display text-2xl">
      <a class="link-underline" href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>{name}</a>
    </h3>
    <span class="font-mono text-xs text-muted whitespace-nowrap">{language}</span>
  </header>
  <p class="mt-3 text-muted">{blurb}</p>
  <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
    <a class="link-underline text-accent-text" href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
      {isLive ? primaryLabel : 'Repository ↗'}
    </a>
    {repo && (
      <a class="link-underline text-muted" href={repo} target="_blank" rel="noopener">Source ↗</a>
    )}
    {seeAlso && (
      <a class="link-underline text-muted" href={seeAlso.href} target="_blank" rel="noopener">{seeAlso.label}</a>
    )}
  </p>
</article>
