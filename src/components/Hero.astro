---
// The "instrument" hero: a figure label, a grotesque headline, a serif deck,
// mono readouts, and a live AURA instrument — an annotated axis of the four
// dimensions the lab studies (Avatars, Users, Relationships, Affect).
const dims = [
  { label: 'avatars',       at: 6 },
  { label: 'users',         at: 35.33 },
  { label: 'relationships', at: 64.67 },
  { label: 'affect',        at: 94 },
];
const stats = [
  { n: '4', k: 'Dimensions' },
  { n: 'R · Python', k: 'Open tools we ship' },
  { n: '0', k: 'Prerequisites to join' },
];
---
<section class="hero container-page" aria-label="AURA Lab">
  <span class="figtag">FIG. 1 — WHAT WE STUDY</span>

  <h1 data-no-split>Bringing <span class="u">methods</span> to the places people live online.</h1>

  <p class="deck">
    Platforms, games, and virtual worlds are real social settings. We study what
    happens inside them — <em>presence, performance, affect</em> — with
    corpus-scale tools and honest claims.
  </p>

  <div class="stats">
    {stats.map((s) => (
      <div class="stat">
        <div class="n">{s.n}</div>
        <div class="k">{s.k}</div>
      </div>
    ))}
  </div>

  <div class="aura" role="img" aria-label="AURA — the four dimensions the lab studies: Avatars, Users, Relationships, Affect">
    <p class="aura-read"><span class="ak" id="heroAk">A — AVATARS</span><span class="at" id="heroAt">how people show up when the body is rendered</span></p>
    <div class="aura-line">
      <span class="aura-dia" id="heroDia" style="left:6%"></span>
      {dims.map((d, i) => (
        <button type="button" class="aura-lab" data-i={i} style={`left:${d.at}%`}>{d.label}</button>
      ))}
    </div>
  </div>
</section>

<script>
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const readouts = [
    { k: 'A — AVATARS',       t: 'how people show up when the body is rendered' },
    { k: 'U — USERS',         t: 'who is in the room, and who gets left out' },
    { k: 'R — RELATIONSHIPS', t: 'how connection forms across a screen' },
    { k: 'A — AFFECT',        t: 'what it feels like, measured honestly' },
  ];
  const pos = [6, 35.33, 64.67, 94];
  const dia = document.getElementById('heroDia');
  const ak = document.getElementById('heroAk');
  const at = document.getElementById('heroAt');
  const read = document.querySelector('.aura-read');
  const labs = Array.from(document.querySelectorAll('.aura-lab'));
  let cur = -1, timer = null;
  function paint(i) {
    ak.textContent = readouts[i].k;
    at.textContent = readouts[i].t;
    dia.style.left = pos[i] + '%';
    labs.forEach((l, j) => l.classList.toggle('on', j === i));
  }
  function go(i) {
    if (i === cur) return;
    if (RM || !read) { cur = i; paint(i); return; }
    read.style.opacity = '0';
    setTimeout(() => { cur = i; paint(i); read.style.opacity = '1'; }, 200);
  }
  function play() { clearInterval(timer); timer = setInterval(() => go((cur + 1) % readouts.length), 3200); }
  function stop() { clearInterval(timer); timer = null; }
  labs.forEach((l, i) => l.addEventListener('click', () => { go(i); stop(); }));
  cur = 0; paint(0);
  if (!RM) play();
</script>

<style>
  .hero { padding: 68px 0 22px; }
  .hero h1 {
    font-size: clamp(44px, 7.2vw, 100px);
    line-height: 1.0;
    max-width: 15ch;
    margin: 22px 0 0;
    color: var(--ink);
    animation: rise 0.7s var(--ease-out) both;
  }
  .hero h1 .u { color: var(--brick); position: relative; white-space: nowrap; }
  .hero h1 .u::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0.05em;
    height: 0.08em; background: var(--brick); opacity: 0.35;
  }
  .deck {
    font-family: theme('fontFamily.serif');
    font-size: clamp(19px, 1.9vw, 24px);
    line-height: 1.42;
    max-width: 54ch;
    margin-top: 24px;
    color: var(--ink);
  }
  .deck em { font-style: italic; color: var(--brick); }
  .stats { display: flex; flex-wrap: wrap; gap: 38px; margin-top: 34px; }
  .stat .n {
    font-family: theme('fontFamily.mono');
    font-size: 1.5rem; font-weight: 500;
    color: var(--brick);
  }
  .stat .k {
    font-family: theme('fontFamily.sans');
    font-size: 0.66rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-soft); margin-top: 2px;
  }

  /* The live AURA instrument — inline, styled like the site's hero axis (no box). */
  .aura { margin-top: 40px; max-width: 640px; }
  .aura-read {
    font-family: theme('fontFamily.mono');
    font-size: 0.72rem; letter-spacing: 0.02em; margin: 0 0 12px;
    display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline;
    transition: opacity 0.22s var(--ease-out);
  }
  .aura-read .ak { color: var(--brick); font-weight: 500; letter-spacing: 0.08em; }
  .aura-read .at { color: var(--ink-soft); }
  .aura-line { position: relative; height: 30px; border-top: 1px solid var(--ink); }
  .aura-dia {
    position: absolute; top: -5px; width: 10px; height: 10px;
    background: var(--siue); border-radius: 1px;
    transform: translateX(-50%) rotate(45deg);
    transition: left 0.7s var(--ease-out); will-change: left;
  }
  .aura-lab {
    position: absolute; top: 8px; transform: translateX(-50%);
    background: none; border: none; padding: 2px 0; cursor: pointer;
    font-family: theme('fontFamily.mono');
    font-size: 0.62rem; color: var(--ink-soft); white-space: nowrap;
    transition: color 0.3s var(--ease-out);
  }
  .aura-lab::before {
    content: ""; position: absolute; top: -8px; left: 50%;
    width: 1px; height: 8px; background: var(--ink);
  }
  .aura-lab:hover { color: var(--ink); }
  .aura-lab.on { color: var(--brick); }

  @keyframes rise { from { opacity: 0; transform: translateY(0.4em); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .hero h1 { animation: none; }
    .aura-dia, .aura-read { transition: none; }
  }
</style>
