---
const year = new Date().getFullYear();
const links = [
  { href: '/students/', label: 'New Students' },
  { href: '/join/', label: 'Join the lab' },
  { href: 'https://www.siue.edu/arts-and-sciences/mass-communications/', label: 'SIUE Mass Communications' },
  { href: 'https://github.com/AURA-Lab-SIUE', label: 'GitHub' },
  { href: 'mailto:aleith@siue.edu', label: 'aleith@siue.edu' },
];
---
<footer class="mt-32">
  <div class="brick-rule" aria-hidden="true"></div>
  <div class="container-page py-12 grid gap-8 md:grid-cols-[1fr_auto] md:items-start">
    <div>
      <p class="colo">AURA Lab</p>
      <p class="acro"><b>A</b>vatars · <b>U</b>sers · <b>R</b>elationships · <b>A</b>ffect</p>
      <p class="meta">
        Studying platforms, games, and virtual worlds as social phenomena.
      </p>
      <p class="meta">
        Department of Mass Communications, College of Arts &amp; Sciences,
        Southern Illinois University Edwardsville · &copy; {year}
      </p>
    </div>
    <nav class="flex flex-col gap-2 md:items-end" aria-label="Footer">
      {links.map((l) => (
        <a class="flink link-underline" href={l.href}>{l.label}</a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .brick-rule { height: 2px; background: var(--brick); }
  .colo {
    font-family: theme('fontFamily.display');
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .acro {
    font-family: theme('fontFamily.sans');
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
  .acro b { color: var(--brick); font-weight: 700; }
  .meta {
    font-size: 0.92rem;
    color: var(--ink-soft);
    max-width: 62ch;
    margin-bottom: 8px;
  }
  .flink {
    font-family: theme('fontFamily.sans');
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }
  .flink:hover { color: var(--brick); }
</style>
