---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PubItem from '../../components/PubItem.astro';
import { getCollection, getEntry } from 'astro:content';

const areas = (await getCollection('research-areas')).sort((a, b) => a.data.order - b.data.order);
const projects = await getCollection('projects');
const pubsEntry = await getEntry('publications', 'pubs');
const pubs = pubsEntry?.data.entries ?? [];

// AURA is the lens; each setting foregrounds some of the four dimensions.
const AURA_OF: Record<string, string[]> = {
  'virtual-environments': ['Avatars', 'Relationships', 'Affect'],
  'streaming': ['Users', 'Relationships', 'Affect'],
  'methods': ['ALL'],
  'meetings': ['Users', 'Relationships'],
};
const AURA_ORDER = ['Avatars', 'Users', 'Relationships', 'Affect'];

const rendered = await Promise.all(areas.map(async (area) => {
  const { Content } = await area.render();
  const areaProjects = projects.filter(p => p.data.area === area.data.area);
  const areaPubs = pubs.filter(p => p.areas.includes(area.data.area as any)).slice(0, 3);
  return { area, Content, areaProjects, areaPubs, dims: AURA_OF[area.data.area] ?? [] };
}));
---
<BaseLayout title="Research" current="research"
  description="AURA Lab research threads — virtual environments, streaming platforms, computational methods, and virtual meetings.">

  <section class="container-page pt-24 pb-8">
    <p class="text-muted uppercase tracking-ui text-sm">What the lab studies</p>
    <h1 class="font-display text-5xl md:text-7xl mt-4 leading-none">Research at AURA Lab.</h1>
    <p class="mt-8 max-w-measure text-lg text-muted">
      We read four dimensions of social experience online —
      <a href="/framework/" class="link-underline text-accent-text">Avatars, Users, Relationships, and Affect</a>.
      The settings below are where we study them: each is a context that foregrounds
      some dimensions more than others, and our methods measure across all four.
    </p>
  </section>

  {rendered.map(({ area, Content, areaProjects, areaPubs, dims }) => (
    <article id={area.data.area}>
      <SectionDivider kicker={`Setting 0${area.data.order} — where we study it`} title={area.data.title} />
      <div class="container-page dim-row">
        <span class="dt-label">AURA</span>
        {dims[0] === 'ALL'
          ? <a href="/framework/" class="dchip all">measures all four →</a>
          : AURA_ORDER.map(o => <span class={`dchip ${dims.includes(o) ? 'hot' : ''}`}>{o}</span>)}
      </div>
      <div class="container-page grid lg:grid-cols-[1fr_2fr] gap-12">
        <div>
          <p class="text-lg max-w-measure">{area.data.blurb}</p>
          <div class="prose-area mt-6 text-muted max-w-measure">
            <Content />
          </div>
        </div>
        <div class="grid gap-4">
          <h3 class="text-xs uppercase tracking-ui text-muted">Active projects</h3>
          {areaProjects.length === 0 && <p class="text-muted">More soon.</p>}
          {areaProjects.map(p => <ProjectCard {...p.data} />)}

          {areaPubs.length > 0 && (
            <>
              <h3 class="text-xs uppercase tracking-ui text-muted mt-6">Representative publications</h3>
              <div>
                {areaPubs.map(p => <PubItem {...p} />)}
              </div>
            </>
          )}
        </div>
      </div>
    </article>
  ))}
</BaseLayout>

<style>
  .prose-area :global(p) { margin: 0.8em 0; }
  .dim-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px;
    margin-top: -0.5rem; margin-bottom: 2rem;
  }
  .dt-label {
    font-family: theme('fontFamily.mono'); font-size: 0.64rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--muted); margin-right: 4px;
  }
  .dchip {
    font-family: theme('fontFamily.mono'); font-size: 0.68rem; letter-spacing: 0.03em;
    padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line);
    color: var(--muted); text-decoration: none;
  }
  .dchip.hot { color: #fff; background: var(--brick-fill); border-color: var(--brick-fill); }
  .dchip.all { color: var(--brick); border-color: var(--brick); background: var(--brick-wash); }
</style>
