---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import { getEntry } from 'astro:content';
import { marked } from 'marked';

const directorEntry = await getEntry('people', 'director');
const director = directorEntry!.data;
const bioHtml = marked.parse(director.bio);

// Each collaborator's AURA dimensions, derived from the publications they've
// co-authored with the lab (the same setting→dimension map used site-wide).
const pubsEntry = await getEntry('publications', 'pubs');
const pubs = pubsEntry?.data.entries ?? [];
const AURA_OF: Record<string, string[]> = {
  'virtual-environments': ['Avatars', 'Relationships', 'Affect'],
  'streaming': ['Users', 'Relationships', 'Affect'],
  'meetings': ['Users', 'Relationships'],
  'methods': ['Avatars', 'Users', 'Relationships', 'Affect'],
};
const AURA_ORDER = ['Avatars', 'Users', 'Relationships', 'Affect'];
function dimsForSurname(surname: string) {
  const areas = new Set<string>();
  for (const p of pubs) {
    if (p.authors.some(a => a.split(',')[0].trim() === surname || a.includes(surname))) {
      for (const ar of p.areas) areas.add(ar);
    }
  }
  return AURA_ORDER.filter(d => [...areas].some(ar => (AURA_OF[ar] ?? []).includes(d)));
}

const collaboratorsRaw = [
  { name: 'Robby Ratan', roles: ['Professor + AT&T Endowed Chair', 'Media & Information, Michigan State University', 'Visiting Scholar, Virtual Human Interaction Lab, Stanford'], orcid: 'https://orcid.org/0000-0001-7611-8046' },
  { name: 'Chaeyun Lim', roles: ['Postdoctoral Fellow', 'Kellogg School of Management, Northwestern University'], orcid: 'https://orcid.org/0000-0003-2570-3071' },
  { name: 'Maxwell Foxman', roles: ['Associate Professor', 'School of Journalism and Communication, University of Oregon'], orcid: 'https://orcid.org/0000-0001-6499-4372' },
  { name: 'David Beyea', roles: ['Associate Professor', 'Department of Communication, University of Wisconsin-Whitewater'], orcid: 'https://orcid.org/0000-0003-4660-008X' },
  { name: 'David C. Jeong', roles: ['Assistant Professor', 'Department of Communication, Santa Clara University'], orcid: 'https://orcid.org/0000-0002-8829-3578' },
  { name: 'Brian Klebig', roles: ['Professor', 'Department of Communication, Bethany Lutheran College'], orcid: 'https://orcid.org/0000-0003-3888-2566' },
];
const collaborators = collaboratorsRaw.map(c => ({ ...c, dims: dimsForSurname(c.name.split(' ').pop() as string) }));
const students = {
  Undergraduate: ['Gerri Marion'],
  Graduate: ['Michelle Poneleit'],
};
const alumni = {
  Undergraduate: ['Erin Gheen', 'Sam Baker', 'Dakota Kasper', 'Dallas Creech', 'Olivia Buente', 'Stephanie Schrage'],
  Graduate: ['Mary Onuche', 'Amanda Cooper'],
};
---
<BaseLayout title="People" current="people"
  description="People at AURA Lab — directed by Dr. Alex P. Leith, with ongoing recruitment.">

  <section class="container-page pt-24 pb-8">
    <p class="text-muted uppercase tracking-ui text-sm">Who runs the lab</p>
    <h1 class="font-display text-5xl md:text-7xl mt-4 leading-none">People.</h1>
  </section>

  <section class="container-page mt-12 grid md:grid-cols-[260px_1fr] lg:grid-cols-[300px_1fr] gap-10 lg:gap-16">
    <div>
      <div class="headshot-wrap">
        <img src={director.headshot} alt={director.headshotAlt} width="512" height="512" loading="eager" />
      </div>
    </div>
    <div>
      <h2 class="font-display text-4xl md:text-5xl leading-tight">{director.name}</h2>
      <ul class="mt-3 text-muted text-sm uppercase tracking-ui space-y-1">
        {director.titles.map(t => <li>{t}</li>)}
      </ul>
      <div class="mt-6 max-w-measure text-lg space-y-4 bio" set:html={bioHtml} />
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <li><a class="link-underline text-accent-text" href={director.links.cv}>Curriculum vitae ↗</a></li>
        <li><a class="link-underline text-accent-text" href={`mailto:${director.links.email}`}>{director.links.email} ↗</a></li>
        <li><a class="link-underline text-accent-text" href={director.links.orcid}>ORCID ↗</a></li>
        <li><a class="link-underline text-accent-text" href={director.links.website}>{director.links.website.replace('https://', '')} ↗</a></li>
        {director.links.github.map(g => (
          <li><a class="link-underline text-accent-text" href={g.href}>github.com/{g.label} ↗</a></li>
        ))}
      </ul>
    </div>
  </section>

  <SectionDivider kicker="The network" title="Collaborators." />
  <section class="container-page">
    <div class="grid gap-6 sm:grid-cols-2">
      {collaborators.map(c => (
        <div class="collab">
          <h3 class="font-display text-2xl leading-tight">{c.name}</h3>
          <ul class="mt-2 text-muted text-sm space-y-0.5">
            {c.roles.map(r => <li>{r}</li>)}
          </ul>
          {c.dims.length > 0 && (
            <p class="cdims" title="AURA dimensions this collaborator works in, from shared publications">
              {c.dims.map(d => <a class="cdim" href={`/publications/`}>{d}</a>)}
            </p>
          )}
          <a class="link-underline text-accent-text text-sm mt-4 inline-block" href={c.orcid}>ORCID ↗</a>
        </div>
      ))}
    </div>
  </section>

  <SectionDivider kicker="In the lab" title="Students." />
  <section class="container-page">
    <div class="grid gap-8 sm:grid-cols-2 roster">
      {Object.entries(students).map(([level, names]) => (
        <div>
          <p class="rlevel">{level}</p>
          <ul class="mt-3 space-y-1 text-lg">
            {names.map(n => <li>{n}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <SectionDivider kicker="Where they are now" title="Alumni." />
  <section class="container-page">
    <div class="grid gap-8 sm:grid-cols-2 roster">
      {Object.entries(alumni).map(([level, names]) => (
        <div>
          <p class="rlevel">{level}</p>
          <ul class="mt-3 space-y-1 text-lg">
            {names.map(n => <li>{n}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <SectionDivider kicker="Open lab" title="Currently recruiting." />
  <section class="container-page max-w-measure text-lg">
    <p>
      AURA Lab is open to students and researchers from any institution — at SIUE,
      across the consortium, or anywhere else. Available paths include empirical
      work on existing corpora (Twitch chat, VRChat tweets, pandemic remote-work
      tweets), methods + tool building, conference co-authorship, and — for SIUE
      students specifically — URCA mentoring and MA thesis chairing or committee
      work.
    </p>
    <p class="mt-6">
      <a href="/join/" class="link-underline text-accent-text">How to join →</a>
    </p>
  </section>
</BaseLayout>

<style>
  .headshot-wrap {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
  }
  .headshot-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bio :global(strong) { color: var(--text); font-weight: 600; }
  .bio :global(p) { max-width: var(--measure); }
  .collab {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 22px 24px;
    box-shadow: var(--shadow-card);
  }
  .collab h3 { color: var(--text); }
  .cdims { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 0.9rem; }
  .cdim {
    font-family: theme('fontFamily.mono'); font-size: 0.62rem; letter-spacing: 0.04em;
    color: var(--brick); text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--brick) 35%, transparent);
    background: var(--brick-wash); padding: 2px 8px; border-radius: 999px;
    transition: background 200ms var(--ease-out), color 200ms var(--ease-out);
  }
  .cdim:hover { background: var(--brick); color: #fff; }
  .rlevel {
    font-family: theme('fontFamily.mono');
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .roster li { color: var(--text); }
</style>
